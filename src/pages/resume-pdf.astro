---
import '../styles/print.css';
import { identity, stats } from '../data/site';
import resume from '../data/resume.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{resume.name} — Résumé</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header>
      <img src="../media/me.jpg" alt="" />
      <div>
        <h1>{resume.name}</h1>
        <p class="tagline">{resume.headline}</p>
        <p class="contact">
          {resume.contact[0]} · {resume.contact[1]}
        </p>
      </div>
    </header>

    <section>
      <h2>Profile</h2>
      <p class="body">{resume.profile}</p>
    </section>

    <section>
      <h2>Education</h2>
      {
        resume.education.map((e) => (
          <div class="education">
            <strong>{e.degree}</strong>
            <div>
              {e.school} — {e.when} — {e.detail}
            </div>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Experience</h2>
      {
        resume.experience.map((e) => (
          <div class="job">
            <div class="row">
              <strong>
                {e.role} — {e.org}
              </strong>
              <span class="when">{e.when}</span>
            </div>
            <ul class="points">
              {e.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Leadership</h2>
      {
        resume.leadership.map((e) => (
          <div class="job">
            <div class="row">
              <strong>
                {e.role} — {e.org}
              </strong>
              <span class="when">{e.when}</span>
            </div>
            <ul class="points">
              {e.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Selected projects</h2>
      {
        resume.projects.map((p) => (
          <div class="job">
            <div class="row">
              <strong>{p.title}</strong>
              <span class="when">{p.right}</span>
            </div>
            <ul class="points">
              {p.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section>
      <h2>Skills</h2>
      {
        resume.skills.map((s) => (
          <p class="skills">
            <b>{s.label}:</b> {s.text}
          </p>
        ))
      }
    </section>

    <section>
      <h2>Certifications &amp; hackathons</h2>
      <p class="body">{resume.certifications}</p>
    </section>

    <footer>
      {stats.repos} public repositories · {stats.languages} languages · building since {stats.since} ·
      résumé generated from src/data/resume.json
    </footer>
  </body>
</html>
