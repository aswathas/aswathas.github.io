---
import Desktop from '../layouts/Desktop.astro';
import { identity } from '../data/site';
---

<Desktop title="Contact" window="Contact" path="/contact/">
  <h1>Contact</h1>
  <p class="lede">Every channel.</p>
  <table class="list">
    <tbody>
      <tr><td>Email</td><td class="date"><a href={`mailto:${identity.email}`}>{identity.email}</a></td></tr>
      <tr><td>GitHub</td><td class="date"><a href={identity.github} rel="noreferrer">{identity.handle}</a></td></tr>
      <tr><td>Writing feed</td><td class="date"><a href="/rss.xml">RSS</a></td></tr>
      <tr><td>For agents</td><td class="date"><a href="/llms.txt">llms.txt</a></td></tr>
    </tbody>
  </table>
</Desktop>