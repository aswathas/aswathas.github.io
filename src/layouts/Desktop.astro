---
import '../styles/desktop.css';
import Palette from './Palette.astro';
import { identity, projects, posts, nav, skills, education, experience } from '../data/site';

const base = (Astro.site?.href ?? 'https://example.com/').replace(/\/$/, '') + '/';

type Props = { title: string; window?: string; path?: string; description?: string; image?: string };
const { title, window: win = title, path = '/', description = identity.tagline, image = '/og.png', current = Astro.url.pathname } =
  Astro.props as Props & { current?: string };

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImage = new URL(image, Astro.site ?? Astro.url.origin).href;

const stats = [
  { label: 'GitHub stars', id: 'stars' },
  { label: 'Repos', id: 'repos' },
  { label: 'Apps shipped', id: 'apps' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={identity.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${identity.name} — Writing`} href="/rss.xml" />
    <link rel="alternate" type="text/markdown" title="Site index for agents" href="/llms.txt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${identity.name} — ${identity.title}`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'Person',
          '@id': `${base}#person`,
          name: identity.name,
          alternateName: [identity.handle],
          url: base,
          jobTitle: identity.title,
          description: identity.bio,
          sameAs: [identity.github, identity.instagram, identity.x].filter(Boolean),
          email: `mailto:${identity.email}`,
          homeLocation: { '@type': 'Place', name: identity.location },
          knowsAbout: skills.slice(0, 12),
          alumniOf: education.map((e) => ({ '@type': 'CollegeOrUniversity', name: e.school })),
          worksFor: { '@type': 'Organization', name: experience[0]?.org ?? 'YUPCHA' },
        },
        {
          '@type': 'WebSite',
          '@id': `${base}#website`,
          url: base,
          name: `${identity.name} — ${identity.title}`,
          description: identity.tagline,
          inLanguage: 'en',
          publisher: { '@id': `${base}#person` },
        },
      ],
    })} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <div class="desk">
      <header class="menubar">
        <span class="apple" aria-hidden="true">●</span>
        <strong class="brand">{win}</strong>

        <details class="menu">
          <summary>Go</summary>
          <div class="sheet">
            <h2>WHERE</h2>
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </div>
        </details>

        <details class="menu">
          <summary>Applications</summary>
          <div class="sheet">
            <h2>APPLICATIONS</h2>
            {projects.slice(0, 8).map((p) => (
              <a href={`/project/${p.slug}/`}>
                <img src={`/projects/${p.slug}.svg`} alt="" width="16" height="16" /> {p.name}
              </a>
            ))}
          </div>
        </details>

        <details class="menu">
          <summary>Window</summary>
          <div class="sheet">
            <h2>WINDOW</h2>
            <a href="#main">Focus</a>
            <a href="/search/">Search everything</a>
          </div>
        </details>

        <details class="menu">
          <summary>Help</summary>
          <div class="sheet">
            <h2>SHORTCUTS</h2>
            <a href="/search/">Search</a>
            <a href="/llms.txt">llms.txt</a>
          </div>
        </details>

        <span class="spacer"></span>
        <button class="menubar-btn" data-palette-open aria-label="Search everything">
          <span aria-hidden="true">⌕</span>
        </button>
        <button class="menubar-btn" data-theme-toggle aria-label="Switch colour theme">
          <span data-theme-icon aria-hidden="true">◐</span>
        </button>
        <span class="clock" data-clock></span>
      </header>

      <div class="stage">
        <div class="window">
          <div class="titlebar">
            <div class="traffic">
              <button type="button" class="light close" data-close-window aria-label="Close window"><span aria-hidden="true">×</span></button>
              <button type="button" class="light minimize" data-minimize aria-label="Minimize window"><span aria-hidden="true">−</span></button>
              <button type="button" class="light zoom" data-zoom aria-label="Zoom window" aria-pressed="false"><span aria-hidden="true">+</span></button>
            </div>
            <span class="title">{win}</span>
            <nav class="breadcrumb" aria-label="Path" style="font-size:11px;color:var(--text-2)">{path}</nav>
          </div>

          <div class="content">
            <nav class="sidebar" aria-label="Applications">
              <h2>APPLICATIONS</h2>
              <ul class="app-tiles">
                {projects.map((p) => (
                  <li>
                    <a
                      href={`/project/${p.slug}/`}
                      title={p.name}
                      aria-current={current === `/project/${p.slug}/` ? 'page' : undefined}
                    >
                      <img src={`/projects/${p.slug}.svg`} alt="" width="24" height="24" />
                      <span>{p.name}</span>
                    </a>
                  </li>
                ))}
              </ul>

              <h2 style="margin-top:16px">ELSEWHERE</h2>
              <a href={identity.github} rel="noreferrer">GitHub</a>
              {identity.instagram && <a href={identity.instagram} rel="noreferrer">Instagram</a>}
              <a href="/rss.xml">RSS</a>
              <a href="/llms.txt">llms.txt</a>
            </nav>

            <main class="pane" id="main">
              <slot />
            </main>
          </div>

          <div class="statusbar">
            <span>{path}</span>
            <span>{projects.length} applications, {posts.length} articles</span>
          </div>
        </div>
      </div>

      <div class="dock-wrap">
        <ul class="dock">
          {
            nav.map((n) => (
              <li>
                <a
                  class="dock-item"
                  href={n.href}
                  title={n.label}
                  aria-current={current === n.href ? 'page' : undefined}
                  data-running={current === n.href ? '' : undefined}
                >
                  <span class="tile" aria-hidden="true">
                    <img src={`/projects/${n.icon}.svg`} alt="" width="34" height="34" />
                  </span>
                  <span class="label">{n.label}</span>
                </a>
              </li>
            ))
          }
          <li>
            <a class="dock-item" href={identity.github} rel="noreferrer" title="GitHub">
              <span class="tile" aria-hidden="true">
                <img src="/projects/github.svg" alt="" width="34" height="34" />
              </span>
              <span class="label">GitHub</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <Palette />

    <script>
      import '../scripts/menubar';
      import '../scripts/dock';
      import '../scripts/window-controls';
      import '../scripts/palette-open';
    </script>

  </body>
</html>