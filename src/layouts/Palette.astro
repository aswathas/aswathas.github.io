---
// ⌘K command palette. One index built from the same data the pages render,
// so nothing can drift out of sync.
import { projects, nav, posts, identity } from '../data/site';

const entries = [
  ...nav.map((n) => ({ group: 'Go', label: n.label, href: n.href, icon: n.icon })),
  ...projects.map((p) => ({
    group: 'Projects',
    label: p.name,
    href: `/project/${p.slug}/`,
    icon: p.slug,
    hint: p.description,
  })),
  ...posts.map((p) => ({ group: 'Writing', label: p.title, href: `/blog/${p.slug}/`, hint: p.summary })),
  { group: 'Go', label: 'GitHub', href: identity.github, icon: 'github' },
  { group: 'Go', label: 'Instagram', href: identity.instagram, icon: 'contact' },
  { group: 'Go', label: 'Résumé (PDF)', href: '/resume.pdf', icon: 'resume' },
  { group: 'Go', label: 'llms.txt', href: '/llms.txt', icon: 'files' },
];
---

<dialog class="palette" aria-label="Command palette">
  <form method="dialog" class="palette-form">
    <input
      type="search"
      class="palette-input"
      placeholder="Jump to a project, page, or file…"
      aria-label="Search commands"
      autocomplete="off"
      spellcheck="false"
    />
  </form>
  <ul class="palette-list" role="listbox" aria-label="Results"></ul>
  <p class="palette-hint"><kbd>↑</kbd><kbd>↓</kbd> move · <kbd>↵</kbd> open · <kbd>esc</kbd> close</p>
</dialog>

<script is:inline define:vars={{ entries }}>
  const dlg = document.querySelector('.palette');
  const input = dlg.querySelector('.palette-input');
  const list = dlg.querySelector('.palette-list');

  let rows = [];
  let active = 0;

  // Same substring rule as /search/, so the palette and search never disagree.
  const match = (q) => {
    const terms = q.toLowerCase().trim().split(/\s+/).filter(Boolean);
    return entries.filter((e) =>
      terms.every((t) => `${e.group} ${e.label} ${e.hint ?? ''}`.toLowerCase().includes(t)),
    );
  };

  const paint = (found) => {
    rows = found;
    active = 0;
    list.replaceChildren(
      ...found.map((e, i) => {
        const li = document.createElement('li');
        li.setAttribute('role', 'option');
        li.id = `palette-row-${i}`;
        if (e.icon) {
          const img = document.createElement('img');
          img.src = `/projects/${e.icon}.svg`;
          img.alt = '';
          img.width = 18;
          img.height = 18;
          li.append(img);
        }
        const text = document.createElement('span');
        text.textContent = e.label;
        li.append(text);
        const group = document.createElement('em');
        group.textContent = e.group;
        li.append(group);
        li.addEventListener('click', () => {
          location.href = e.href;
        });
        return li;
      }),
    );
    if (!found.length) {
      const li = document.createElement('li');
      li.className = 'empty';
      li.textContent = 'No matches';
      list.replaceChildren(li);
    }
    mark();
  };

  const mark = () => {
    [...list.children].forEach((li, i) => {
      li.classList.toggle('active', i === active);
      li.setAttribute('aria-selected', String(i === active));
    });
    input.setAttribute('aria-activedescendant', rows.length ? `palette-row-${active}` : '');
  };

  const move = (d) => {
    if (!rows.length) return;
    active = (active + d + rows.length) % rows.length;
    mark();
    list.children[active]?.scrollIntoView({ block: 'nearest' });
  };

  const open = () => {
    dlg.showModal();
    input.value = '';
    paint(entries);
    input.focus();
  };

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      dlg.open ? dlg.close() : open();
    }
  });

  input.addEventListener('input', () => paint(match(input.value)));

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); move(1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); move(-1); }
    else if (e.key === 'Enter') {
      e.preventDefault();
      if (rows[active]) location.href = rows[active].href;
    }
  });

  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>